module fir_optimized(
    input  wire clk,
    input  wire rst,
    input  wire signed [15:0] x_in,
    input  wire signed [15:0] h [0:99],
    output reg  signed [39:0] y_out
);

parameter TAPS = 100;

// Accumulator temp register
reg signed [39:0] acc;

// Symmetric sum temp register
reg signed [16:0] sym_sum;

// Delay line
reg signed [15:0] x_delay [0:TAPS-1];

integer i;

// Shift register (delay line)
always @(posedge clk or posedge rst) begin
    if(rst) begin
        for(i = 0; i < TAPS; i = i + 1)
            x_delay[i] <= 16'sd0;
    end
    else begin
        for(i = TAPS-1; i > 0; i = i - 1)
            x_delay[i] <= x_delay[i-1];

        x_delay[0] <= x_in;
    end
end

// Optimized FIR computation using symmetry: h[k] = h[N-1-k]
always @(posedge clk or posedge rst) begin
    if (rst) begin
        sym_sum <= 17'sd0;
        y_out <= 40'sd0;
    end else begin
        acc = 40'sd0;
        for(i = 0; i < TAPS/2; i = i + 1) begin
            sym_sum = {x_delay[i][15], x_delay[i]} + {x_delay[TAPS-1-i][15], x_delay[TAPS-1-i]};
            acc = acc + (h[i] * sym_sum);
        end
        y_out <= acc;
    end
end

endmodule