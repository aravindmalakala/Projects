clc;
clearvars;
close all;

% Filter Coefficients
fs = 10000;
fc = 1000;
n_taps = 100;

% Normalize cutoff frequency by Nyquist frequency (Fs/2)
Wn = fc/(fs/2);

% Design a low-pass FIR filter using the specified coefficients
b = fir1(n_taps-1, Wn);

% Converting into Q(2,14)
b_q = round(b * 2^14);

% Storing the filter coefficints in a file
fid = fopen('filter_coeff_q214.txt','w');
fprintf(fid,'%d\n',b_q);
fclose(fid);

% Generate 3 sinewaves of 950Hz, 1100Hz, 2000Hz and sample at 10000Hz
t = 0:1/fs:1-1/fs; % Time vector for 1 second
sinewave1 = sin(2 * pi * 950 * t);
sinewave2 = sin(2 * pi * 1100 * t);
sinewave3 = sin(2 * pi * 2000 * t);

% Converting into Q(2,14)
sinewave1_q = round(sinewave1 * 2^14);
sinewave2_q = round(sinewave2 * 2^14);
sinewave3_q = round(sinewave3 * 2^14);

% Storing them in seperate Files
fid1 = fopen('sinewave1_q214.txt', 'w');
fprintf(fid1, '%d\n', sinewave1_q);
fclose(fid1);

fid2 = fopen('sinewave2_q214.txt', 'w');
fprintf(fid2, '%d\n', sinewave2_q);
fclose(fid2);

fid3 = fopen('sinewave3_q214.txt', 'w');
fprintf(fid3, '%d\n', sinewave3_q);
fclose(fid3);


% Apply the FIR filter to the sinewaves
output1 = filter(b, 1, sinewave1);
output2 = filter(b, 1, sinewave2);
output3 = filter(b, 1, sinewave3);

% Plot outputs
figure;

subplot(3,1,1)
plot(t,output1)
title('Output for 950 Hz')
xlabel('Time(s)')
ylabel('Amplitude')

subplot(3,1,2)
plot(t,output2)
title('Output for 1100 Hz')
xlabel('Time(s)')
ylabel('Amplitude')

subplot(3,1,3)
plot(t,output3)
title('Output for 2000 Hz')
xlabel('Time(s)')
ylabel('Amplitude')