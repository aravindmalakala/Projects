module fir_direct(
    input  wire clk,
    input  wire rst,
    input  wire signed [15:0] x_in,
    input  wire signed [15:0] h [0:99],
    output reg  signed [39:0] y_out
);

parameter TAPS = 100;

// Accumulator temp register
reg signed [39:0] acc;

// Delay line
reg signed [15:0] x_delay [0:TAPS-1];

integer i;

// Shift register (delay line)
always @(posedge clk or posedge rst) begin
    if(rst) begin
        for(i = 0; i < TAPS; i = i + 1)
            x_delay[i] <= 16'sd0;
    end
    else begin
        for(i = TAPS-1; i > 0; i = i - 1)
            x_delay[i] <= x_delay[i-1];

        x_delay[0] <= x_in;
    end
end

// FIR computation
always @(posedge clk or posedge rst) begin
    if (rst) begin
        y_out <= 40'sd0;
    end else begin
        acc = 40'sd0;
        for (i = 0; i < TAPS; i = i + 1)
            acc = acc + (x_delay[i] * h[i]);

        // Register output
        y_out <= acc;
    end
end

endmodule